# Discord Bot — publica rolagens já calculadas neste site (um único bot, N servidores).
# Instruções: https://discord.com/developers/applications
# Copie para .env.local e preencha (nunca commite .env.local).

# Token do bot (Bot → Reset Token). Nunca expor no frontend.
DISCORD_BOT_TOKEN=

# Supabase — guarda apenas: sessionCode (mesa) → guildId → channelId.
# Dashboard do projeto → Project Settings → API.
# NUNCA use o prefixo NEXT_PUBLIC_ nestas chaves (server-side apenas).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Mesa online (modo grupo).
# A MESMA URL/key do projeto acima, mas expostas ao navegador (por isso o prefixo NEXT_PUBLIC_).
# Precisam estar definidas em build/runtime para o Realtime funcionar; sem elas o app
# cai automaticamente em polling a cada 4s (o modo online continua funcionando, só mais lento).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
