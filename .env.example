# Required: choose one mode explicitly.
MESA_HOSTING_MODE=local
# PostgreSQL is never exposed to players; only the Next server uses this URL.
MESA_LOCAL_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/<database>
MESA_HOSTNAME=0.0.0.0
PORT=3000
# Optional host-only file used by the server setup screen to persist a mode
# change. It must not be exposed to the browser.
MESA_HOSTING_MODE_FILE=
# Path to a protected, randomly generated host-admin token file. The Windows
# installer provisions it under %ProgramData%; never expose its contents.
MESA_HOST_ADMIN_TOKEN_FILE=

# Only required in supabase mode (never put the service key in NEXT_PUBLIC_*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
