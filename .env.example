# Discord Bot — publica rolagens realizadas no site em um canal do Discord.
# Instruções: https://discord.com/developers/applications
# Copie este arquivo para .env.local e preencha os valores (nunca commite o .env.local).

# Token do bot (Bot → Reset Token). Nunca expor no frontend.
DISCORD_BOT_TOKEN=

# ID do canal de destino (clique com botão direito no canal → Copiar ID do canal)
DISCORD_CHANNEL_ID=
