# Discord Bot — publica no Discord rolagens já calculadas neste site.
# Instruções: https://discord.com/developers/applications
# Copie este arquivo para .env.local e preencha os valores (nunca commite o .env.local).

# Token do único bot (Bot → Reset Token). Nunca expor no frontend.
# O bot pode estar em vários servidores; o canal de cada mesa é configurado
# no painel "Discord Integration" da gaveta 🎲 Dados (arquivo ./data/discord-sessions.json).
DISCORD_BOT_TOKEN=

# Opcional: pasta onde fica o arquivo de configuração das mesas (padrão: ./data)
# DISCORD_DATA_DIR=
